{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "vitest", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "warn",
    "react/react-in-jsx-scope": "off",
    "import/no-unassigned-import": ["warn", { "allow": ["@fontsource-variable/*"] }],
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "regex": "^(\\.\\./)+(src/)?(components|effects)/[^/]+/.+",
            "message": "Import another slice through its index.ts, not a file inside it."
          },
          {
            "regex": "^\\.\\./[^./][^/]*/[^/]+$",
            "message": "Import another slice through its index.ts, not a file inside it."
          },
          {
            "group": [
              "../../*/*",
              "!../../../**",
              "!../../shared/*",
              "!../../components/*",
              "!../../effects/*",
              "!../../test/*"
            ],
            "message": "Import another slice through its index.ts, not a file inside it."
          }
        ]
      }
    ]
  },
  "ignorePatterns": ["dist", "dist-demo", ".gpu-check"]
}
